{% trans_default_domain "ShopifyBundle" %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'oauth2.connected.title'|trans }}</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f4f6f9;
            color: #2d3748;
        }
        .card {
            max-width: 420px;
            padding: 2.5rem;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
            text-align: center;
        }
        .icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            background: #38a169;
            color: #fff;
            font-size: 34px;
            line-height: 64px;
        }
        h1 {
            margin: 0 0 .75rem;
            font-size: 1.4rem;
        }
        p {
            margin: 0;
            color: #718096;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">&#10003;</div>
        <h1>{{ 'oauth2.connected.title'|trans }}</h1>
        <p>{{ 'oauth2.connected.text'|trans({ '%shop%': shop }) }}</p>
    </div>
</body>
</html>
